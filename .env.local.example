# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers (Groq only — get free keys at console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_2=your_second_groq_key_optional
GROQ_API_KEY_3=your_third_groq_key_optional
# Fallback key used by deepResearch.ts when primary is rate-limited (optional — defaults to GROQ_API_KEY)
GROQ_API_KEY_FALLBACK=your_fallback_groq_key_optional

# Web Search — Tavily (https://tavily.com — paid, ~$0.008/call on the dev plan)
# Get up to 4 API keys; the search module round-robins with auto-failover.
# Set at least TAVILY_API_KEY_1; add _2/_3/_4 for higher throughput.
TAVILY_API_KEY_1=tvly-your_first_key
TAVILY_API_KEY_2=tvly-your_second_key_optional
TAVILY_API_KEY_3=tvly-your_third_key_optional
TAVILY_API_KEY_4=tvly-your_fourth_key_optional

# Legacy SearXNG (kept dormant — only set if you want to re-enable it)
# SEARXNG_URL=http://localhost:8080

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Set this in Razorpay Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
