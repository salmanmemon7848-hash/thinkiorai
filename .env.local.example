# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Providers (Groq only — get free keys at console.groq.com)
GROQ_API_KEY=your_groq_api_key
GROQ_API_KEY_2=your_second_groq_key_optional
GROQ_API_KEY_3=your_third_groq_key_optional
# Fallback key used by deepResearch.ts when primary is rate-limited (optional — defaults to GROQ_API_KEY)
GROQ_API_KEY_FALLBACK=your_fallback_groq_key_optional

# Web Search — SearXNG (run locally: docker run -p 8080:8080 searxng/searxng)
SEARXNG_URL=http://localhost:8080

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
# Set this in Razorpay Dashboard → Settings → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
